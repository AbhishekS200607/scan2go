{
  "version": 2,
  "name": "scan2go",
  "builds": [
    {
      "src": "api/index.js",
      "use": "@vercel/node"
    },
    {
      "src": "client/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "api/index.js"
    },
    {
      "src": "/css/(.*)",
      "dest": "client/css/$1"
    },
    {
      "src": "/js/(.*)",
      "dest": "client/js/$1"
    },
    {
      "src": "/customer/(.*)",
      "dest": "client/customer/$1"
    },
    {
      "src": "/security/(.*)",
      "dest": "client/security/$1"
    },
    {
      "src": "/admin/(.*)",
      "dest": "client/admin/$1"
    },
    {
      "src": "/",
      "dest": "client/index.html"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/(.*)",
      "dest": "client/index.html"
    }
  ]
}
